QMainWindow { background: #101820; }
QWidget { font-size: 13px; }
QLabel { color: #e7eff6; }
QToolBar { spacing: 8px; padding: 12px 16px; background: #18232e; border-bottom: 1px solid #344656; }
QPushButton, QComboBox { color: #e7eff6; background: #18232e; border: 1px solid #344656; border-radius: 7px; padding: 9px 12px; }
QPushButton:hover, QComboBox:hover { background: #223d46; border-color: #53d7c3; }
QPushButton:focus, QComboBox:focus, QPlainTextEdit:focus { border: 2px solid #53d7c3; }
QPushButton:pressed { background: #223d46; }
QPushButton:disabled { color: #a9b9c8; border-color: #344656; background: #101820; }
QPushButton#PrimaryButton { background: #53d7c3; color: #102b30; font-weight: 600; }
QPushButton#PrimaryButton:disabled { background: #101820; color: #a9b9c8; }
QComboBox QAbstractItemView { background: #18232e; color: #e7eff6; selection-background-color: #223d46; selection-color: #e7eff6; }
QFrame#Header { background: transparent; border: none; }
QFrame#Card { background: #18232e; border: 1px solid #344656; border-radius: 12px; }
QLabel#TitleLabel { font-size: 25px; font-weight: 700; }
QLabel#SubtitleLabel, QLabel#PrivacyLabel { color: #a9b9c8; }
QLabel#SectionLabel { font-size: 15px; font-weight: 600; }
QLabel#Feedback { color: #ffbdb3; background: #392a2d; padding: 12px; border-radius: 7px; }
QPlainTextEdit#SvgEditor { color: #e7eff6; background: #101820; border: 1px solid #344656; border-radius: 8px; padding: 12px; selection-background-color: #223d46; }
QStatusBar { color: #a9b9c8; background: #18232e; border-top: 1px solid #344656; }
QSplitter::handle { background: #101820; width: 8px; }
QDialog, QMessageBox { color: #e7eff6; background: #18232e; }
QMessageBox QLabel { color: #e7eff6; background: transparent; }
